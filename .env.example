# Telegram BotFather orqali oling
BOT_TOKEN=123456:replace_me

# Jamendo Developer portalidan olingan Client ID
JAMENDO_CLIENT_ID=replace_me

# AudD API token — video/audio ichidagi qo‘shiqni tanish uchun
AUDD_TOKEN=replace_me

# Ovozli xabarda aytilgan nomni matnga aylantirish uchun (ixtiyoriy)
OPENAI_API_KEY=replace_me

# Ixtiyoriy sozlamalar
MAX_UPLOAD_MB=25
DB_PATH=music_bot.db
